---
import {
    defaultLocale,
    supportedLocales,
} from '../../../domains/localization/config/locale.config';
import { content } from '../../../domains/localization/data/content';
import type { Locale } from '../../../domains/localization/types/locale.type';
import type { ServiceId } from '../../../features/service-offerings/enums/service-id.enum';
import {
    serviceIds,
    serviceSlugById,
} from '../../../features/service-offerings/config/service-route.config';
import ServicePage from '../../../features/service-offerings/ui/pages/ServicePage/ServicePage.astro';

interface Props {
    locale: Locale;
    serviceId: ServiceId;
}

export function getStaticPaths() {
    return supportedLocales
        .filter((locale) => locale !== defaultLocale)
        .flatMap((locale) =>
            serviceIds.map((serviceId) => ({
                params: {
                    locale,
                    service: serviceSlugById[serviceId],
                },
                props: { locale, serviceId },
            })),
        );
}

const { locale, serviceId } = Astro.props;
---

<ServicePage content={content[locale]} {serviceId} />
