---
import styles from './ServiceItem.module.css';
import type {
    ServiceContent,
    ServiceOfferingsContent,
} from '../../../interfaces/service-content.interface';
import ServiceVisual from '../../molecules/ServiceVisual/ServiceVisual.astro';
import { getServicePath } from '../../../config/service-route.config';
import type { Locale } from '../../../../../domains/localization/types/locale.type';

interface Props {
    service: ServiceContent;
    locale: Locale;
    imageAlt: ServiceOfferingsContent['imageAlt'];
    complianceVisualLabel: string;
    complianceBadges: ServiceOfferingsContent['complianceBadges'];
    learnMore: string;
    alternate?: boolean;
}

const {
    service,
    locale,
    imageAlt,
    complianceVisualLabel,
    complianceBadges,
    learnMore,
    alternate = false,
} = Astro.props;
---

<article
    class:list={[
        styles['service'],
        'shell',
        {
            [styles['service-alt']]: alternate,
        },
    ]}
    id={service.id}
>
    <div class:list={[styles['service-copy']]}>
        <p class:list={[styles['service-kicker']]}>{service.kicker}</p>
        <h3>{service.title}</h3>
        <p>{service.text}</p>
        <ul>
            {service.items.map((item) => (
                <li>{item}</li>
            ))}
        </ul>
        <a
            class:list={[styles['text-link']]}
            href={getServicePath(locale, service.id)}
        >
            {learnMore} <span aria-hidden="true">→</span>
        </a>
    </div>
    <ServiceVisual
        serviceId={service.id}
        imageAlt={imageAlt}
        complianceVisualLabel={complianceVisualLabel}
        complianceBadges={complianceBadges}
        alternate={alternate}
    />
</article>
