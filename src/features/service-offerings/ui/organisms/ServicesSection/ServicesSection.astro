---
import styles from './ServicesSection.module.css';
import type { ServiceOfferingsContent } from '../../../interfaces/service-content.interface';
import type { Locale } from '../../../../../domains/localization/types/locale.type';
import ExpertiseGrid from '../ExpertiseGrid/ExpertiseGrid.astro';
import ServiceItem from '../ServiceItem/ServiceItem.astro';
import Eyebrow from '../../../../../components/atoms/Eyebrow/Eyebrow.astro';

interface Props {
    content: ServiceOfferingsContent;
    locale: Locale;
}

const { content, locale } = Astro.props;
---

<section
    class:list={[styles['services-section']]}
    id="services"
    aria-labelledby="services-title"
>
    <div class:list={['shell', styles['section-heading']]}>
        <Eyebrow tone="accent">{content.eyebrow}</Eyebrow>
        <h2 id="services-title">{content.title}</h2>
        <p>{content.intro}</p>
    </div>

    <ExpertiseGrid content={content} />

    <div class:list={[styles['services']]} id="solutions">
        {content.items.map((service, index) => (
            <ServiceItem
                service={service}
                {locale}
                imageAlt={content.imageAlt}
                complianceVisualLabel={content.complianceVisualLabel}
                complianceBadges={content.complianceBadges}
                learnMore={content.learnMore}
                alternate={index % 2 === 1}
            />
        ))}
    </div>
</section>
