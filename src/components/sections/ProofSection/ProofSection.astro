---
import styles from './ProofSection.module.css';
import type { SiteContent } from '../../../domains/site/interfaces/site-content.interface';

interface Props {
    content: SiteContent['proof'];
}

const { content } = Astro.props;
---

<section class:list={[styles['proof']]} id="why" aria-labelledby="proof-title">
    <div class="shell">
        <div class:list={[styles['section-heading'], 'compact']}>
            <p class="eyebrow cyan">{content.eyebrow}</p>
            <h2 id="proof-title">{content.title}</h2>
        </div>
        <div class:list={[styles['metrics']]} aria-label={content.metricsLabel}>
            {content.metrics.map(([value, label]) => (
                <div>
                    <strong>{value}</strong>
                    <span>{label}</span>
                </div>
            ))}
        </div>
        <div class:list={[styles['quotes']]}>
            {content.quotes.map(([quote, name, role, initials]) => (
                <figure>
                    <blockquote>“{quote}”</blockquote>
                    <figcaption>
                        <span class:list={[styles['avatar']]}>{initials}</span>
                        <div>
                            <strong>{name}</strong>
                            <small>{role}</small>
                        </div>
                    </figcaption>
                </figure>
            ))}
        </div>
    </div>
</section>
