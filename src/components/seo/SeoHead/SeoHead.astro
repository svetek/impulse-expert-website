---
import { getImage } from 'astro:assets';
import socialImageSource from '../../../assets/images/hero-datacenter.png';
import ThemeHead from '../../../domains/theme/ui/ThemeHead.astro';
import { siteConfig } from '../../../domains/site/config/site.config';
import type { SiteContent } from '../../../domains/site/interfaces/site-content.interface';
import type { Locale } from '../../../domains/localization/types/locale.type';
import {
    defaultLocale,
    localeConfig,
} from '../../../domains/localization/config/locale.config';

interface Props {
    locale: SiteContent['locale'];
    siteName: SiteContent['siteName'];
    seo: SiteContent['seo'];
    pageTitle: string;
    pageDescription: string;
    robots: string;
    canonicalPath?: string | null;
    alternatePaths?: Partial<Record<Locale, string>>;
    structuredData?: Array<Record<string, unknown>>;
}

const {
    locale,
    siteName,
    seo,
    pageTitle,
    pageDescription,
    robots,
    alternatePaths,
    structuredData = [],
} = Astro.props;
const site = Astro.site ?? new URL(siteConfig.fallbackUrl);
const currentLocale = localeConfig[locale];
const canonicalPath =
    Astro.props.canonicalPath === undefined
        ? currentLocale.path
        : Astro.props.canonicalPath;
const canonical = canonicalPath ? new URL(canonicalPath, site) : null;
const alternateLocales = Object.entries(localeConfig).map(
    ([alternateLocale, config]) => [
        alternateLocale,
        {
            ...config,
            path: alternatePaths?.[alternateLocale as Locale] ?? config.path,
        },
    ],
) as Array<[Locale, (typeof localeConfig)[Locale]]>;
const socialImage = await getImage({
    src: socialImageSource,
    width: 1200,
    height: 630,
    format: 'jpeg',
    quality: 85,
    fit: 'cover',
    position: 'center',
});
const ogImage = new URL(socialImage.src, site);
const organizationSchema = {
    '@type': 'Organization',
    '@id': new URL('/#organization', site).href,
    name: siteName,
    url: new URL('/', site).href,
    email: siteConfig.email,
    description: seo.description,
};
const websiteSchema = {
    '@type': 'WebSite',
    '@id': new URL('/#website', site).href,
    url: new URL('/', site).href,
    name: siteName,
    publisher: {
        '@id': organizationSchema['@id'],
    },
    inLanguage: Object.keys(localeConfig),
};
const schemaGraph = {
    '@context': 'https://schema.org',
    '@graph': [organizationSchema, websiteSchema, ...structuredData],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<ThemeHead />
<meta name="description" content={pageDescription} />
<meta name="robots" content={robots} />
{canonical && <link rel="canonical" href={canonical} />}
{canonical &&
    alternateLocales.map(([locale, config]) => (
        <link
            rel="alternate"
            hreflang={locale}
            href={new URL(config.path, site)}
        />
    ))}
{canonical && (
    <link
        rel="alternate"
        hreflang="x-default"
        href={
            new URL(
                alternatePaths?.[defaultLocale] ??
                    localeConfig[defaultLocale].path,
                site,
            )
        }
    />
)}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={currentLocale.openGraphLocale} />
{alternateLocales
    .filter(([alternateLocale]) => alternateLocale !== locale)
    .map(([, config]) => (
        <meta property="og:locale:alternate" content={config.openGraphLocale} />
    ))}
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={seo.socialImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImage} />

<title>{pageTitle}</title>
<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
