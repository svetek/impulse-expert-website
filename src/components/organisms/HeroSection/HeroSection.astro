---
import styles from './HeroSection.module.css';
import { Image } from 'astro:assets';
import heroImage from '../../../assets/images/hero-datacenter.png';
import type { SiteContent } from '../../../domains/site/interfaces/site-content.interface';
import ActionLink from '../../atoms/Action/ActionLink.astro';
import Eyebrow from '../../atoms/Eyebrow/Eyebrow.astro';

interface Props {
    content: SiteContent['hero'];
}

const { content } = Astro.props;
---

<section class:list={[styles['hero']]} aria-labelledby="hero-title">
    <div class:list={[styles['hero-image']]} aria-hidden="true">
        <Image
            class={styles['hero-background']}
            src={heroImage}
            alt=""
            widths={[640, 960, 1280, 1600, 2048]}
            sizes="100vw"
            quality="high"
            priority
        />
    </div>
    <div class:list={[styles['hero-grid']]} aria-hidden="true"></div>
    <div class:list={['shell', styles['hero-content']]}>
        <Eyebrow>{content.eyebrow}</Eyebrow>
        <h1 id="hero-title">
            {content.title}
            <br />
            <span>{content.accent}</span>
        </h1>
        <p class:list={[styles['hero-lede']]}>{content.text}</p>
        <div class:list={[styles['hero-actions']]}>
            <ActionLink href="#contact">
                {content.talk} <span aria-hidden="true">→</span>
            </ActionLink>
            <ActionLink variant="ghost" href="#services">
                {content.explore}
            </ActionLink>
        </div>
    </div>
    <div class:list={[styles['scroll-cue']]} aria-hidden="true">
        <span></span>
        {content.scroll}
    </div>
</section>
