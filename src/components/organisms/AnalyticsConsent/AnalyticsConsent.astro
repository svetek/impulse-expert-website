---
import styles from './AnalyticsConsent.module.css';
import { analyticsConfig } from '../../../domains/analytics/config/analytics.config';
import type { SiteContent } from '../../../domains/site/interfaces/site-content.interface';
import ActionButton from '../../atoms/Action/ActionButton.astro';

interface Props {
    content: SiteContent['analytics'];
}

const { content } = Astro.props;
const {
    googleAnalyticsId,
    yandexMetrikaId,
    enabled: analyticsEnabled,
} = analyticsConfig;
---

{analyticsEnabled && (
    <aside
        class:list={[styles['analytics-consent']]}
        data-analytics-consent
        hidden
        aria-label={content.preferencesLabel}
    >
        <p>{content.notice}</p>
        <div>
            <ActionButton size="small" data-analytics-accept>
                {content.accept}
            </ActionButton>
            <button
                type="button"
                class:list={[styles['consent-decline']]}
                data-analytics-decline
            >
                {content.decline}
            </button>
        </div>
    </aside>
)}

<script
    is:inline
    define:vars={{ googleAnalyticsId, yandexMetrikaId, analyticsEnabled }}
>
    (() => {
        if (!analyticsEnabled) return;

        const consentKey = 'impulse-analytics-consent';
        const stateKey = '__impulseAnalyticsState';
        const state = window[stateKey] || {
            initialized: false,
            loaded: false,
            controller: null,
        };
        window[stateKey] = state;

        const readConsent = () => {
            try {
                return localStorage.getItem(consentKey);
            } catch {
                return null;
            }
        };

        const saveConsent = (value) => {
            try {
                localStorage.setItem(consentKey, value);
            } catch {
                // Analytics consent still applies for the current page load.
            }
        };

        const loadAnalytics = () => {
            if (state.loaded) {
                if (yandexMetrikaId && window.ym) {
                    window.ym(
                        Number(yandexMetrikaId),
                        'hit',
                        window.location.href,
                    );
                }
                return;
            }
            state.loaded = true;

            if (googleAnalyticsId) {
                const script = document.createElement('script');
                script.async = true;
                script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(googleAnalyticsId)}`;
                document.head.append(script);
                window.dataLayer = window.dataLayer || [];
                window.gtag = function () {
                    window.dataLayer.push(arguments);
                };
                window.gtag('js', new Date());
                window.gtag('config', googleAnalyticsId, {
                    anonymize_ip: true,
                });
            }

            if (yandexMetrikaId) {
                window.ym =
                    window.ym ||
                    function () {
                        (window.ym.a = window.ym.a || []).push(arguments);
                    };
                window.ym.l = Date.now();
                const script = document.createElement('script');
                script.async = true;
                script.src = 'https://mc.yandex.ru/metrika/tag.js';
                document.head.append(script);
                window.ym(Number(yandexMetrikaId), 'init', {
                    clickmap: true,
                    trackLinks: true,
                    accurateTrackBounce: true,
                    webvisor: false,
                });
            }
        };

        const initializeConsent = () => {
            state.controller?.abort();
            state.controller = new AbortController();
            const { signal } = state.controller;
            const banner = document.querySelector('[data-analytics-consent]');
            const preferencesButton = document.querySelector(
                '[data-analytics-preferences]',
            );
            const savedConsent = readConsent();

            if (savedConsent === 'accepted') loadAnalytics();
            if (!savedConsent && banner) banner.hidden = false;

            banner?.querySelector('[data-analytics-accept]')?.addEventListener(
                'click',
                () => {
                    saveConsent('accepted');
                    banner.hidden = true;
                    loadAnalytics();
                },
                { signal },
            );
            banner?.querySelector('[data-analytics-decline]')?.addEventListener(
                'click',
                () => {
                    const analyticsWasLoaded = state.loaded;
                    saveConsent('declined');
                    banner.hidden = true;
                    if (analyticsWasLoaded) window.location.reload();
                },
                { signal },
            );
            preferencesButton?.addEventListener(
                'click',
                () => {
                    if (!banner) return;
                    banner.hidden = false;
                    banner.querySelector('[data-analytics-accept]')?.focus();
                },
                { signal },
            );
            document.addEventListener(
                'click',
                (event) => {
                    if (!(event.target instanceof Element)) return;
                    const target = event.target.closest(
                        '[data-analytics-event]',
                    );
                    if (!target || readConsent() !== 'accepted') return;

                    const eventName = target.getAttribute(
                        'data-analytics-event',
                    );
                    const eventLabel = target.getAttribute(
                        'data-analytics-label',
                    );
                    if (!eventName) return;

                    const parameters = eventLabel
                        ? { event_label: eventLabel }
                        : {};
                    if (googleAnalyticsId && window.gtag) {
                        window.gtag('event', eventName, parameters);
                    }
                    if (yandexMetrikaId && window.ym) {
                        window.ym(
                            Number(yandexMetrikaId),
                            'reachGoal',
                            eventName,
                            parameters,
                        );
                    }
                },
                { signal },
            );
        };

        if (state.initialized) return;
        state.initialized = true;
        document.addEventListener('astro:page-load', initializeConsent);
    })();
</script>
