---
import styles from './ContactDetailsSection.module.css';
import { siteConfig } from '../../../domains/site/config/site.config';
import type { SiteContent } from '../../../domains/site/interfaces/site-content.interface';

interface Props {
    content: SiteContent['contact']['details'];
}

const { content } = Astro.props;
const { phone, address } = siteConfig.contact;
---

<section
    class:list={[styles['contacts']]}
    id="contact"
    aria-labelledby="contact-title"
>
    <div class:list={['shell', styles['contacts-inner']]}>
        <header class:list={[styles['heading']]}>
            <h2 id="contact-title">{content.title}</h2>
            <p>{content.text}</p>
        </header>

        <div class:list={[styles['contact-grid']]}>
            <a class:list={[styles['contact-card']]} href={phone.href}>
                <span class:list={[styles['icon']]} aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M6.6 3.5 9 8.2 7.3 9.9a15.7 15.7 0 0 0 6.8 6.8l1.7-1.7 4.7 2.4v2.1a2 2 0 0 1-2 2A16 16 0 0 1 2.5 5.5a2 2 0 0 1 2-2Z"></path>
                    </svg>
                </span>
                <span class:list={[styles['card-copy']]}>
                    <small>{content.phoneLabel}</small>
                    <strong>{phone.display}</strong>
                </span>
                <span class:list={[styles['arrow']]} aria-hidden="true">
                    →
                </span>
            </a>

            <a
                class:list={[styles['contact-card']]}
                href={address.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
            >
                <span class:list={[styles['icon']]} aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                        <circle cx="12" cy="10" r="2.5"></circle>
                    </svg>
                </span>
                <span class:list={[styles['card-copy']]}>
                    <small>{content.addressLabel}</small>
                    <strong>{address.display}</strong>
                    <span>{content.mapLabel}</span>
                </span>
                <span class:list={[styles['arrow']]} aria-hidden="true">
                    ↗
                </span>
            </a>
        </div>
    </div>
</section>
