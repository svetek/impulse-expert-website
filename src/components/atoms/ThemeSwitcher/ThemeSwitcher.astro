---
import styles from './ThemeSwitcher.module.css';
import type { ThemeId } from '../../../domains/theme/types/theme-id.type';

interface Props {
    label: string;
    themeNames: Record<ThemeId, string>;
}

const { label, themeNames } = Astro.props;
---

<button
    class:list={[styles['switcher']]}
    type="button"
    data-theme-switcher
    data-label={label}
    data-theme-names={JSON.stringify(themeNames)}
    aria-label={label}
    title={label}
>
    <svg class:list={[styles['sun']]} viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
    </svg>
    <svg class:list={[styles['moon']]} viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5 8.5 8.5 0 1 0 20.5 14.3Z"></path>
    </svg>
</button>

<script>
    import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
    import { getThemeController } from '../../../domains/theme/services/theme.service';

    let themeSwitcherController: AbortController | undefined;

    const initializeThemeSwitcher = () => {
        themeSwitcherController?.abort();
        themeSwitcherController = new AbortController();
        const { signal } = themeSwitcherController;
        const switcher = document.querySelector<HTMLButtonElement>(
            '[data-theme-switcher]',
        );
        const themeController = getThemeController();
        if (!switcher || !themeController) return;
        const { themeIds } = themeController;

        const themeNames = JSON.parse(
            switcher.dataset.themeNames ?? '{}',
        ) as Record<string, string>;
        const syncControl = (themeId: (typeof themeIds)[number]) => {
            const currentIndex = themeIds.indexOf(themeId);
            const nextTheme = themeIds[(currentIndex + 1) % themeIds.length];
            const nextThemeName = themeNames[nextTheme] ?? nextTheme;
            const label = switcher.dataset.label ?? '';
            const actionLabel = `${label}: ${nextThemeName}`;
            switcher.setAttribute('aria-label', actionLabel);
            switcher.title = actionLabel;
        };
        const currentTheme =
            themeController.getAppliedTheme() ?? themeController.resolveTheme();
        syncControl(currentTheme);

        document.addEventListener(
            'theme:change',
            () => {
                const activeTheme = themeController.getAppliedTheme();
                if (activeTheme) syncControl(activeTheme);
            },
            { signal },
        );

        switcher.addEventListener(
            'click',
            () => {
                const activeTheme =
                    themeController.getAppliedTheme() ??
                    themeController.resolveTheme();
                const currentIndex = themeIds.indexOf(activeTheme);
                const nextTheme =
                    themeIds[(currentIndex + 1) % themeIds.length];
                if (!themeController.isThemeId(nextTheme)) return;
                themeController.storeTheme(nextTheme);
                themeController.applyTheme(nextTheme);
            },
            { signal },
        );

        themeController.followSystemPreference(signal);
    };

    document.addEventListener('astro:before-swap', (event) => {
        const { newDocument } = event as TransitionBeforeSwapEvent;
        const themeController = getThemeController();
        if (!themeController) return;
        themeController.applyTheme(
            themeController.getAppliedTheme() ?? themeController.resolveTheme(),
            newDocument,
        );
    });
    document.addEventListener('astro:page-load', initializeThemeSwitcher);
</script>
